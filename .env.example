# Copy to .env for local runs. In Portainer, enter these as stack
# environment variables instead — do not commit a filled-in .env.

HOST_PORT=8080
DATA_PATH=/volume1/docker/airbnb-optimizer
TZ=America/New_York
BASE_URL=http://synology.local:8080

DAILY_RUN_HOUR=8
DAILY_RUN_MINUTE=5
RUN_ON_STARTUP=false

SCRAPE_PAGES=3
SCRAPE_DELAY_MS=2500
SCRAPE_TIMEOUT_MS=45000

EMAIL_ENABLED=true
EMAIL_TO=charlton@idbpro.com
EMAIL_FROM=charlton@idbpro.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=charlton@idbpro.com
# Gmail: create an App Password, not your account password.
SMTP_PASS=replace-me
SMTP_STARTTLS=true
SMTP_SSL=false
